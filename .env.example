# Скопируйте в .env и заполните. В продакшне (APP_ENV=production) сервер не стартует без секретов.
# .env в git не коммитим.

APP_ENV=production
DOMAIN=odin.example.ru
CORS_ORIGINS=https://odin.example.ru

# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
POSTGRES_PASSWORD=

# Ключ шифрования персональных данных. Сгенерировать:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Ротация: новый ключ первым, старый через запятую; после пересохранения данных старый можно убрать.
# Потеря ключа = потеря зашифрованных данных: храните копию в менеджере секретов.
DATA_ENCRYPTION_KEYS=

# Вход через Telegram Mini App: токен бота от @BotFather (без него работает только анонимный вход)
TELEGRAM_BOT_TOKEN=

# Необязательные настройки (значения по умолчанию)
# SESSION_TTL_DAYS=30
# BOOKING_PII_RETENTION_DAYS=1095
# POLICY_VERSION=2026-10-27
# LIMIT_AGENT_PER_MIN=30
# LIMIT_AGENT_PER_DAY=500
# LIMIT_AGENT_GLOBAL_PER_DAY=20000
# LIMIT_AUTH_PER_IP_PER_MIN=10
# LIMIT_SESSIONS_PER_HOUR=30
